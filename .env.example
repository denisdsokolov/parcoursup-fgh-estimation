# Two-digit Parcoursup data year used by FGH_data_proc.py.
PARCOURSUP_YEAR=24

# Processed input/output directory used by FGH_main.py and FGH_data_proc.py.
PARCOURSUP_DATA_DIR=FGH_data_Yc_Yq

# Simulation controls.
PARCOURSUP_BUNCH_SIZE=10
PARCOURSUP_BUNCHES=50
PARCOURSUP_SEED=2024
PARCOURSUP_RESULT_YEAR=2024
PARCOURSUP_FINAL_ANALYSIS=true

# Data-processing and estimation switches.
PARCOURSUP_EXCLUDE_CANDIDATES=true
PARCOURSUP_EXCLUDE_SEATS=true
PARCOURSUP_PRINT_STATS=false
PARCOURSUP_USE_ROLS=false
PARCOURSUP_LOAD_ROLS=true
